{
  "_meta": {
    "purpose": "Map historical or formal-state country labels coming from Wikidata into the modern display name used across the UI. Applied at a single chokepoint in process.py so every downstream JSON inherits the same vocabulary.",
    "categories": {
      "A": "Formal modern-state name to common display name. Lossless — same polity, different label conventions.",
      "B": "Historical state with a single unambiguous modern successor. Defensible — drops some historical specificity but matches how museum catalogs and atlases display these."
    },
    "deliberately_not_normalized": [
      "Russian Empire / Russian SFSR / Soviet Union / Byelorussian SSR — multi-successor; could be Russia, Ukraine, Belarus, Lithuania, Latvia, Estonia, Poland, Finland, Georgia, Armenia, Kazakhstan or others.",
      "Czechoslovakia / Federal People's Republic of Yugoslavia / Kingdom of Yugoslavia / Federal Republic of Yugoslavia / Kingdom of Serbs, Croats and Slovenes / Socialist Federal Republic of Yugoslavia — multi-successor.",
      "Ottoman Empire — 30+ successor states.",
      "Yemen, Republic of China, Dominion of India — political-status questions deferred until we have a stronger editorial position."
    ],
    "see_also": "docs/COUNTRY_NORMALIZATION.md"
  },
